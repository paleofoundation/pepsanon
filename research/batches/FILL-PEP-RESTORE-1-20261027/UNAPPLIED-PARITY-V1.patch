+import {ExternalLink,LockKeyhole} from 'lucide-react';
+import records from '@/lib/data/restored-research-previews.json';
+import {breadcrumbs} from '@/lib/seo';
+import {StructuredData} from './structured-data';
+import {RestoredPreviewContents} from './restored-preview-contents';
+import './restored-research-preview.css';
+
+export function restoredPreview(id:string){const record=records.find(row=>row.id===id);if(!record)throw new Error('Outside restored-preview allowlist');return record;}
+export function restoredPreviewMetadata(id:string){const r=restoredPreview(id);return {title:{absolute:r.metadataTitle},description:r.description,alternates:{canonical:r.canonical},robots:{index:true,follow:true}};}
+export function RestoredResearchPreview({id}:{id:string}){
+ const r=restoredPreview(id);const path=`/research/${r.id}`;
+ return <article className="study-review-page" data-study-review={r.id}>
+  <StructuredData data={breadcrumbs([{name:'Home',path:'/'},{name:'Research reviews',path:'/research'},{name:r.title,path}])}/>
+  <header className="research-hero"><div className="research-hero__wrapper"><div className="research-hero__left"><div className="research-hero__left-content"><p>A review of one research paper.</p><a href="/research#questions">Our review questions</a></div></div><div className="research-hero__center"><nav aria-label="Breadcrumb" className="review-breadcrumb"><a href="/research">Research reviews</a><span aria-hidden="true"> / </span><span>{r.year}</span></nav><h1 className="research-hero__center-title">{r.title}</h1><div className="research-hero__center-tags"><a className="research-hero__center-tag" href={r.originalUrl} target="_blank" rel="noreferrer">Original paper <ExternalLink size={16}/></a><a className="research-hero__center-tag" href={r.pdfUrl} target="_blank" rel="noreferrer">Source PDF <ExternalLink size={16}/></a><a className="research-hero__center-tag" href="#preview">Preview</a></div></div><div className="research-hero__right review-credit"><p className="section-kicker">Study review</p><p><strong>Editorial draft</strong></p><p>Prepared by AI-assisted editorial draft; independent review pending</p><p>Not independently approved.</p><p>Review version {r.version}</p><p>Paper published: {r.year}</p></div></div></header>
+  <div className="research-content"><div className="research-content__wrapper"><RestoredPreviewContents/><div className="research-content__center entry-content"><section id="preview" className="review-preview"><h2>Study at a glance</h2><dl className="research-facts"><dt>Design</dt><dd>{r.design}</dd><dt>Who or what was studied</dt><dd>{r.population}</dd>{r.doi&&<><dt>DOI</dt><dd><a href={`https://doi.org/${r.doi}`} target="_blank" rel="noreferrer">{r.doi}</a></dd></>}</dl><p>{r.finding}</p><p className="research-panel-limitation"><strong>Key limitation: </strong>{r.limitation}</p><p className="review-source-locators">Preview sources: {r.locators.map((source,index)=><span key={source.url}>{index>0?'; ':''}<a href={source.url} target="_blank" rel="noreferrer">{source.label}</a></span>)}</p><p className="review-draft-notice">This is an AI-assisted editorial draft. Unresolved questions and source checks are identified in the review; it has not received independent methodological or clinical approval.</p></section><section className="review-access"><LockKeyhole aria-hidden="true"/><h2>Log in to read the full review</h2><p>Read the methods, numerical findings, harms, limitations, and source locations with a free PepsAnon account.</p><a className="primary-action" href={`/login?returnTo=${encodeURIComponent(path)}`}>Log in to continue</a><p className="study-note">No subscription or payment is required.</p></section></div><aside className="research-content__right review-context" aria-label="Paper context"><h2>About this review</h2><p>Fifteen questions cover the study’s methods, findings, harms, reliability, and relevance.</p><p>One paper can support a specific observation without establishing treatment benefit or safety.</p><a href="/research#questions">Read the review standard</a><h3>Original sources</h3>{r.sourceLinks.map(source=><p key={source.url}><a href={source.url} target="_blank" rel="noreferrer">{source.label}</a></p>)}</aside></div></div>
+ </article>;
+}
